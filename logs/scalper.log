#!/bin/bash

# ============================================
# Crypto Scalper 1 Minuto v2.0
# - Simplificado y robusto
# - Fallback automático cuando DeepSeek falla
# ============================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# ============================================
# CARGAR CONFIGURACIÓN
# ============================================

if [ -f .env ]; then
    source .env
else
    echo "❌ Error: .env no encontrado"
    exit 1
fi

# ============================================
# MODO DRY-RUN
# ============================================

DRY_RUN=false
if [[ "$1" == "--dry-run" ]] || [[ "$1" == "-d" ]]; then
    DRY_RUN=true
    echo "🔍 MODO DRY-RUN"
fi

# ============================================
# CONFIGURACIÓN
# ============================================

DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-}"
FINANDY_SECRET="${FINANDY_SECRET:-d1a01uf5uoe}"
FINANDY_WEBHOOK="${FINANDY_WEBHOOK:-https://hook.finandy.com/LMEnRji-3GvFkm7wqFUK}"
TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN:-}"
TELEGRAM_CHAT_ID="${TELEGRAM_CHAT_ID:-}"

SCALPER_TP_PERCENT="${SCALPER_TP_PERCENT:-0.5}"
SCALPER_SL_PERCENT="${SCALPER_SL_PERCENT:-0.3}"
SCALPER_MAX_SYMBOLS="${SCALPER_MAX_SYMBOLS:-3}"
SCALPER_SCHEDULER_MINUTES="${SCALPER_SCHEDULER_MINUTES:-2}"

LOG_DIR="$SCRIPT_DIR/logs"
mkdir -p "$LOG_DIR"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'

# ============================================
# FUNCIONES BÁSICAS
# ============================================

log() {
    echo -e "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_DIR/scalper.log"
}

log_error() {
    echo -e "${RED}[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: $1${NC}" | tee -a "$LOG_DIR/scalper_errors.log"
}

send_telegram() {
    [ -z "$TELEGRAM_BOT_TOKEN" ] || [ -z "$TELEGRAM_CHAT_ID" ] && return 1
    local msg=$(echo "$1" | sed 's/\\/\\\\/g' | sed 's/\-/\\-/g' | sed 's/\./\\\\./g')
    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -H "Content-Type: application/json" \
        -d "{\"chat_id\": \"${TELEGRAM_CHAT_ID}\", \"text\": \"${msg}\"}" > /dev/null
}

# ============================================
# FUNCIONES DE BINANCE
# ============================================

get_current_price() {
    local symbol="$1"
    local ticker=$(curl -s "https://api.binance.com/api/v3/ticker/price?symbol=$symbol" 2>/dev/null)
    echo "$ticker" | jq -r '.price // 0' 2>/dev/null
}

get_24h_change() {
    local symbol="$1"
    local ticker=$(curl -s "https://api.binance.com/api/v3/ticker/24hr?symbol=$symbol" 2>/dev/null)
    echo "$ticker" | jq -r '.priceChangePercent // 0' 2>/dev/null
}

get_order_book_levels() {
    local symbol="$1"
    local depth="${2:-5}"
    local order_book=$(curl -s "https://api.binance.com/api/v3/depth?symbol=$symbol&limit=$depth" 2>/dev/null)
    
    local support=""
    local resistance=""
    
    # Extraer mejor bid (compra) - soporte
    local best_bid=$(echo "$order_book" | jq -r '.bids[0][0] // ""' 2>/dev/null)
    # Extraer mejor ask (venta) - resistencia
    local best_ask=$(echo "$order_book" | jq -r '.asks[0][0] // ""' 2>/dev/null)
    
    if [ -n "$best_bid" ] && [ "$best_bid" != "null" ] && [ "$best_bid" != "0" ]; then
        support="$best_bid"
    fi
    if [ -n "$best_ask" ] && [ "$best_ask" != "null" ] && [ "$best_ask" != "0" ]; then
        resistance="$best_ask"
    fi
    
    echo "$support|$resistance"
}

# ============================================
# DETERMINAR ESTRATEGIA (sin DeepSeek)
# ============================================

determine_strategy() {
    local symbol="$1"
    local current_price="$2"
    local change_24h="$3"
    local support="$4"
    local resistance="$5"
    
    local trend="NEUTRAL"
    local confidence=0
    local entry_price="$current_price"
    local sl=""
    local tp=""
    
    # Estrategia 1: Basada en soporte/resistencia del order book
    if [ -n "$support" ] && [ -n "$resistance" ]; then
        # Calcular posición del precio en el rango
        local range=$(echo "$resistance - $support" | bc -l 2>/dev/null)
        if [ -n "$range" ] && (( $(echo "$range > 0" | bc -l 2>/dev/null) )); then
            local position=$(echo "($current_price - $support) / $range * 100" | bc -l 2>/dev/null)
            
            if (( $(echo "$position < 20" | bc -l 2>/dev/null) )); then
                trend="LONG"
                confidence=70
                entry_price=$(printf "%.8f" $(echo "$support * 1.001" | bc -l))
            elif (( $(echo "$position > 80" | bc -l 2>/dev/null) )); then
                trend="SHORT"
                confidence=70
                entry_price=$(printf "%.8f" $(echo "$resistance * 0.999" | bc -l))
            fi
        fi
    fi
    
    # Estrategia 2: Basada en cambio 24h (fallback)
    if [ "$trend" = "NEUTRAL" ]; then
        if (( $(echo "$change_24h > 5" | bc -l 2>/dev/null || echo "0") )); then
            trend="SHORT"
            confidence=50
            entry_price=$(printf "%.8f" $(echo "$current_price * 0.999" | bc -l))
        elif (( $(echo "$change_24h < -5" | bc -l 2>/dev/null || echo "0") )); then
            trend="LONG"
            confidence=50
            entry_price=$(printf "%.8f" $(echo "$current_price * 1.001" | bc -l))
        else
            trend="NEUTRAL"
            confidence=30
        fi
    fi
    
    # Calcular SL y TP basados en la tendencia
    if [ "$trend" = "LONG" ]; then
        sl=$(printf "%.8f" $(echo "$entry_price * (1 - $SCALPER_SL_PERCENT/100)" | bc -l))
        tp=$(printf "%.8f" $(echo "$entry_price * (1 + $SCALPER_TP_PERCENT/100)" | bc -l))
    elif [ "$trend" = "SHORT" ]; then
        sl=$(printf "%.8f" $(echo "$entry_price * (1 + $SCALPER_SL_PERCENT/100)" | bc -l))
        tp=$(printf "%.8f" $(echo "$entry_price * (1 - $SCALPER_TP_PERCENT/100)" | bc -l))
    fi
    
    echo "$trend|$confidence|$entry_price|$sl|$tp"
}

# ============================================
# ENVIAR ORDEN
# ============================================

send_order() {
    local symbol="$1" direction="$2" entry="$3" sl="$4" tp="$5"
    
    local side="buy" pos_side="long"
    if [ "$direction" = "SHORT" ]; then
        side="sell" pos_side="short"
    fi
    
    local order_name="Scalp_${symbol}_$(date '+%Y%m%d_%H%M%S')"
    
    local payload=$(cat <<EOF
{
  "name": "$order_name",
  "secret": "$FINANDY_SECRET",
  "symbol": "$symbol",
  "side": "$side",
  "positionSide": "$pos_side",
  "open": {
    "price": "$entry",
    "schedulerMode": "min",
    "schedulerValue": "$SCALPER_SCHEDULER_MINUTES"
  },
  "tp": {
    "enabled": true,
    "orders": [{"price": "$tp", "piece": "100.0"}]
  },
  "sl": {"price": "$sl", "enabled": true}
}
EOF
)
    
    log "📝 SCALP: $symbol $direction | Entry:$entry SL:$sl TP:$tp"
    
    if [ "$DRY_RUN" = true ]; then
        log "🔍 DRY-RUN: No se ejecutó"
        send_telegram "🔍 DRY-RUN: $symbol $direction Entry:$entry TP:$tp"
        return 0
    fi
    
    local response=$(curl -s -X POST "$FINANDY_WEBHOOK" -H "Content-Type: application/json" -d "$payload")
    
    if echo "$response" | jq -e '.code == 200 or .success == true' >/dev/null 2>&1; then
        log "✅ Orden ejecutada: $symbol"
        send_telegram "⚡ SCALP: $symbol $direction Entry:$entry TP:$tp"
    else
        log_error "Fallo: $response"
    fi
}

# ============================================
# OBTENER TOP MOVERS
# ============================================

get_top_movers() {
    local response=$(curl -s "https://api.binance.com/api/v3/ticker/24hr" 2>/dev/null)
    
    local gainers=$(echo "$response" | jq -r '
        .[] | 
        select(.symbol | endswith("USDT")) |
        select(.symbol | test("^[A-Z0-9]+USDT$")) |
        select(.priceChangePercent | tonumber > 3) |
        .symbol
    ' 2>/dev/null | head -"$SCALPER_MAX_SYMBOLS")
    
    local losers=$(echo "$response" | jq -r '
        .[] | 
        select(.symbol | endswith("USDT")) |
        select(.symbol | test("^[A-Z0-9]+USDT$")) |
        select(.priceChangePercent | tonumber < -3) |
        .symbol
    ' 2>/dev/null | head -"$SCALPER_MAX_SYMBOLS")
    
    echo "$gainers|$losers"
}

# ============================================
# PROCESAR UN SÍMBOLO
# ============================================

process_symbol() {
    local symbol="$1"
    
    log "${YELLOW}🔍 Analizando $symbol${NC}"
    
    # Obtener datos
    local current_price=$(get_current_price "$symbol")
    if [ -z "$current_price" ] || [ "$current_price" = "0" ] || [ "$current_price" = "null" ]; then
        log_error "No se pudo obtener precio para $symbol"
        return 1
    fi
    
    local change_24h=$(get_24h_change "$symbol")
    local ob_levels=$(get_order_book_levels "$symbol")
    local support=$(echo "$ob_levels" | cut -d'|' -f1)
    local resistance=$(echo "$ob_levels" | cut -d'|' -f2)
    
    log "📊 $symbol | Precio: $current_price | 24h: ${change_24h}%"
    [ -n "$support" ] && log "   Soporte OB: $support | Resistencia OB: $resistance"
    
    # Determinar estrategia
    local strategy=$(determine_strategy "$symbol" "$current_price" "$change_24h" "$support" "$resistance")
    local trend=$(echo "$strategy" | cut -d'|' -f1)
    local confidence=$(echo "$strategy" | cut -d'|' -f2)
    local entry=$(echo "$strategy" | cut -d'|' -f3)
    local sl=$(echo "$strategy" | cut -d'|' -f4)
    local tp=$(echo "$strategy" | cut -d'|' -f5)
    
    log "🎯 Estrategia: $trend (confianza: ${confidence}%)"
    
    if [ "$trend" = "NEUTRAL" ] || [ "$confidence" -lt 50 ]; then
        log "⏸️ Sin señal clara, saltando"
        return 0
    fi
    
    send_order "$symbol" "$trend" "$entry" "$sl" "$tp"
}

# ============================================
# LOOP PRINCIPAL
# ============================================

main() {
    log "${BLUE}⚡ Scalper 1M v2.0 iniciado${NC}"
    log "📋 TP:${SCALPER_TP_PERCENT}% SL:${SCALPER_SL_PERCENT}%"
    
    if [ "$DRY_RUN" = true ]; then
        send_telegram "🔍 DRY-RUN: Scalper 1M iniciado"
    else
        send_telegram "⚡ Scalper 1M iniciado - TP:${SCALPER_TP_PERCENT}% SL:${SCALPER_SL_PERCENT}%"
    fi
    
    local cycle=0
    while true; do
        cycle=$((cycle + 1))
        log "${BLUE}━━━━━━━ Ciclo #$cycle ━━━━━━━${NC}"
        
        local movers=$(get_top_movers)
        local gainers=$(echo "$movers" | cut -d'|' -f1)
        local losers=$(echo "$movers" | cut -d'|' -f2)
        
        log "📈 Gainers: $(echo "$gainers" | tr '\n' ' ')"
        log "📉 Losers: $(echo "$losers" | tr '\n' ' ')"
        
        local processed=0
        
        for symbol in $gainers; do
            [ $processed -ge $SCALPER_MAX_SYMBOLS ] && break
            process_symbol "$symbol"
            processed=$((processed + 1))
            sleep 2
        done
        
        for symbol in $losers; do
            [ $processed -ge $SCALPER_MAX_SYMBOLS ] && break
            process_symbol "$symbol"
            processed=$((processed + 1))
            sleep 2
        done
        
        log "${GREEN}✅ Ciclo completado - ${processed} símbolos${NC}"
        log "⏰ Esperando 60 segundos..."
        sleep 60
    done
}

